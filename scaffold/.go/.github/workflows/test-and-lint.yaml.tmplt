name: Unit Test and Lint

on:
  push:
    branches:
      - main

  pull_request:

  workflow_dispatch:

permissions:
  contents: read

jobs:
  test-and-lint:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v7

      - name: Set up Go
        id: setup-go
        uses: actions/setup-go@v7
        with:
          go-version: "^{% .GoVersion %}"

      - name: Set up Python
        uses: actions/setup-python@v7
        with:
          python-version: "3.14"

      - name: Install pre-commit
        run: pip install pre-commit

      # golangci-lint is built from source with the installed Go and refuses to run
      # when that Go is older than go.mod targets, so key on the Go version too.
      - name: Cache pre-commit environments
        uses: actions/cache@v6
        with:
          path: ~/.cache/pre-commit
          key: pre-commit-${{ runner.os }}-${{ steps.setup-go.outputs.go-version }}-${{ hashFiles('.pre-commit-config.yaml') }}

      - name: Run unit test
        run: make test

      - name: Verify golangci-lint config
        run: make verify

      # Runs only the golangci-lint-full hook, so gelato doesn't run in CI.
      - name: Lint
        run: make lint
